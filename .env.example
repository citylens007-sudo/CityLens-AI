DATABASE_URL=postgresql+psycopg://citylens:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/citylens
POSTGRES_DB=citylens
POSTGRES_USER=citylens
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
ADMIN_BOOTSTRAP_NAME=CityLens Administrator
ROAD_DAMAGE_MODEL_PATH=REPLACE_WITH_LOCAL_MODEL_PATH
ROAD_DAMAGE_SAMPLE_INTERVAL_SECONDS=1.0
ROAD_VIDEO_MAX_UPLOAD_BYTES=524288000
ROAD_VIDEO_MAX_DURATION_SECONDS=3600
PUBLIC_APP_URL=http://localhost:5173
# Render/Neon deployments: set DATABASE_URL to the Neon pooled endpoint with sslmode=require.
# Example form: postgresql+psycopg://USER:PASSWORD@POOLER-HOST/DBNAME?sslmode=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
EVIDENCE_STORAGE_PATH=./var/evidence
ROAD_VIDEO_STORAGE_PATH=./var/road-videos
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15
